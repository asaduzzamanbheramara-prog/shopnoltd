        "options": {}
      },
      "id": "auth",
      "name": "Authenticate Webhook",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst title = String(body.title ?? '').trim();\nconst content = String(body.content ?? '').trim();\nif (!title) throw new Error('title_required');\nif (!content) throw new Error('content_required');\nif (title.length > 300) throw new Error('title_too_long');\nif (content.length > 30000) throw new Error('content_too_long');\nreturn [{json:{title,content,excerpt:body.excerpt ? String(body.excerpt).slice(0,1000) : null,slug:body.slug ? String(body.slug).slice(0,320) : null,cover_image:body.cover_image ? String(body.cover_image).slice(0,2000) : null,status:'draft'}}];"
      },
      "id": "normalize",
      "name": "Validate Blog Draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.shopnoltd.dpdns.org/api/v1/blog",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SHOPNOLTD_N8N_BLOG_DRAFT_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "create-draft",
      "name": "Create Shopnoltd Draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond-created",
      "name": "Respond Draft Created",
      "type": "n8n-nodes-base.respondToWebhook",
