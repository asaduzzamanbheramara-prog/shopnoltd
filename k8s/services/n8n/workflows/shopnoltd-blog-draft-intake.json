    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "webhook-secret-check",
              "leftValue": "={{!!$env.SHOPNOLTD_N8N_WEBHOOK_SECRET && $json.headers[\"x-shopnoltd-webhook-secret\"] === $env.SHOPNOLTD_N8N_WEBHOOK_SECRET}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
