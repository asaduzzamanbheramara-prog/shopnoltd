{
  "id": "b4c8c0a7-5e32-47e0-a2b9-4d7c4a1f92d3",
  "name": "Shopnoltd - Platform Account Registry",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopnoltd/omnichannel/account",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook (Account)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -420,
        0
      ],
      "webhookId": "shopnoltd-omnichannel-account"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst platforms = ['whatsapp','facebook','instagram','linkedin','x','telegram','tiktok','youtube','gmail','outlook','3cx'];\nconst platform = String(body.platform || '').toLowerCase();\nif (!platforms.includes(platform)) {\n  return [{json:{success:false,status:'unsupported',error:'unsupported_platform',platform}}];\n}\nif (!body.platform_account_id) {\n  return [{json:{success:false,status:'rejected',error:'platform_account_id_required',platform}}];\n}\nreturn [{json:{\n  platform,\n  account_type:body.account_type || 'user',\n  platform_account_id:String(body.platform_account_id),\n  username:body.username ?? null,\n  display_name:body.display_name ?? null,\n  status:body.status || 'connected',\n  scopes:Array.isArray(body.scopes) ? body.scopes : [],\n  access_token_ref:body.access_token_ref ?? null,\n  refresh_token_ref:body.refresh_token_ref ?? null,\n  token_expires_at:body.token_expires_at ?? null,\n  metadata:body.metadata ?? {}\n}}];"
      },
      "id": "normalize",
      "name": "Normalize Account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.shopnoltd.dpdns.org/api/v1/omnichannel/connections",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SHOPNOLTD_INTERNAL_AUTOMATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {}
      },
      "id": "register",
      "name": "Register Connection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond",
      "name": "Respond 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        360,
        0
      ]
    }
  ],
  "connections": {
    "Webhook (Account)": {
      "main": [
        [
          {
            "node": "Normalize Account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Account": {
      "main": [
        [
          {
            "node": "Register Connection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Connection": {
      "main": [
        [
          {
            "node": "Respond 201",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}