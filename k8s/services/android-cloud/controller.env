ANDROID_CLOUD_NAMESPACE=shopno-android
ANDROID_CLOUD_EMULATOR_IMAGE=us-docker.pkg.dev/android-emulator-268719/images/30-google-x64:30.1.2
ANDROID_CLOUD_GATEWAY_IMAGE=ghcr.io/asaduzzamanbheramara-prog/shopnoltd/android-cloud-gateway:76ec2c181c43c01c62bdcf7163bef58a08fe99a2
ANDROID_CLOUD_GATEWAY_BASE=https://android-gateway.shopnoltd.dpdns.org/sessions
ANDROID_CLOUD_PUBLIC_HOST=android-gateway.shopnoltd.dpdns.org
ANDROID_CLOUD_MAX_SESSIONS=1
ANDROID_CLOUD_SESSION_TTL_SECONDS=1800
ANDROID_CLOUD_MAX_APK_BYTES=104857600
ANDROID_CLOUD_SHOPNOLTD_APK_URL=https://shopnoltd.dpdns.org/download/Shopnoltd.apk
ANDROID_CLOUD_SHOPNOLTD_ADMIN_APK_URL=https://shopnoltd.dpdns.org/download/Shopnoltd-Admin.apk
ANDROID_CLOUD_SHOPNOLTD_COLLECT_APK_URL=https://shopnoltd.dpdns.org/download/ShopnoltdCollect.apk
