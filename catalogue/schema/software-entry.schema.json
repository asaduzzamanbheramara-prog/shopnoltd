{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopnoltd.dpdns.org/schemas/software-entry.schema.json",
  "title": "Shopnoltd Software Catalogue Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "kind",
    "description",
    "platforms",
    "source",
    "license_note",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "kind": {
      "type": "string",
      "enum": [
        "operating-system",
        "application",
        "driver",
        "recovery-tool",
        "documentation"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "linux",
          "macos",
          "android",
          "ios",
          "ipados",
          "chromeos",
          "tvos",
          "watchos",
          "harmonyos",
          "kaios",
          "bsd",
          "web",
          "firmware",
          "cross-platform",
          "other"
        ]
      }
    },
    "architectures": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "x86_64",
          "x86",
          "arm64",
          "arm",
          "arm64-v8a",
          "armeabi-v7a",
          "riscv64",
          "mips",
          "ppc64le",
          "s390x",
          "wasm32",
          "universal",
          "any"
        ]
      }
    },
    "version": {
      "type": "string",
      "maxLength": 100
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "official-download-page",
            "official-release",
            "repository",
            "documentation"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "publisher": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "license_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "status"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "publisher-signature",
            "publisher-checksum",
            "source-only-not-yet-verified"
          ]
        },
        "checksum_algorithm": {
          "type": "string",
          "enum": [
            "sha256",
            "sha512"
          ]
        },
        "checksum": {
          "type": "string",
          "pattern": "^(?:[a-fA-F0-9]{64}|[a-fA-F0-9]{128})$"
        },
        "status": {
          "type": "string",
          "enum": [
            "needs-review",
            "verified",
            "blocked"
          ]
        },
        "evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "pricing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "free",
            "paid-shopnoltd-feature",
            "external-vendor-license"
          ]
        },
        "entitlement_key": {
          "type": "string",
          "maxLength": 120
        }
      }
    },
    "installation_guide": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "device_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "desktop",
          "laptop",
          "workstation",
          "server",
          "phone",
          "tablet",
          "tv",
          "wearable",
          "router",
          "single-board-computer",
          "virtual-machine",
          "embedded",
          "browser",
          "other"
        ]
      }
    },
    "package_formats": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "exe",
          "msi",
          "msix",
          "appx",
          "dmg",
          "pkg",
          "appimage",
          "deb",
          "rpm",
          "flatpak",
          "snap",
          "apk",
          "apks",
          "xapk",
          "aab",
          "ipa",
          "zip",
          "tar",
          "iso",
          "img",
          "bin",
          "source",
          "web-app",
          "container",
          "firmware",
          "other"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "required": [
              "evidence_url"
            ],
            "properties": {
              "method": {
                "enum": [
                  "publisher-signature",
                  "publisher-checksum"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "pricing": {
            "properties": {
              "model": {
                "const": "paid-shopnoltd-feature"
              }
            },
            "required": [
              "model"
            ]
          }
        },
        "required": [
          "pricing"
        ]
      },
      "then": {
        "properties": {
          "pricing": {
            "required": [
              "entitlement_key"
            ],
            "properties": {
              "entitlement_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "checksum_algorithm": {
                "const": "sha256"
              }
            },
            "required": [
              "checksum_algorithm"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "checksum": {
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "checksum_algorithm": {
                "const": "sha512"
              }
            },
            "required": [
              "checksum_algorithm"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "checksum": {
                "pattern": "^[a-fA-F0-9]{128}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "method": {
                "const": "publisher-checksum"
              }
            },
            "required": [
              "method"
            ]
          }
        },
        "required": [
          "verification"
        ]
      },
      "then": {
        "properties": {
          "verification": {
            "required": [
              "checksum_algorithm",
              "checksum"
            ]
          }
        }
      }
    }
  ]
}
