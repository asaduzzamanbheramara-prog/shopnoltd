{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shopnoltd.dpdns.org/schemas/software-os-entitlements-response.schema.json",
  "title": "Software & OS Center entitlement response",
  "description": "Illustrative response contract for the future authenticated GET /api/v1/me/entitlements endpoint. This schema does not grant access or prove payment.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "entitlements"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_id",
          "status",
          "valid_from",
          "valid_until"
        ],
        "properties": {
          "product_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,95}$"
          },
          "status": {
            "const": "active"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "valid_until": {
            "oneOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
