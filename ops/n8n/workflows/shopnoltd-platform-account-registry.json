          }
        ]
      ]
    },
    "Normalize Account": {
      "main": [
        [
          {
            "node": "Register Connection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Register Connection": {
      "main": [
        [
          {
