{
  "id": "b4c8c0a7-5e32-47e0-a2b9-4d7c4a1f92d3",
  "name": "Shopnoltd - Platform Account Registry",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "shopnoltd/omnichannel/account",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook (Account)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -420,
        0
      ],
      "webhookId": "shopnoltd-omnichannel-account"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst platforms = ['whatsapp','facebook','instagram','linkedin','x','telegram','tiktok','youtube','gmail','outlook','3cx'];\nconst platform = String(body.platform || '').trim().toLowerCase();\nif (!platforms.includes(platform)) {\n  throw new Error('unsupported_platform');\n}\nconst platformAccountId = String(body.platform_account_id ?? '').trim();\nif (!platformAccountId) {\n  throw new Error('platform_account_id_required');\n}\nreturn [{json:{\n  platform,\n  account_type:body.account_type || 'user',\n  platform_account_id:platformAccountId,\n  username:body.username ?? null,\n  display_name:body.display_name ?? null,\n  status:body.status || 'connected',\n  scopes:Array.isArray(body.scopes) ? body.scopes : [],\n  access_token_ref:body.access_token_ref ?? null,\n  refresh_token_ref:body.refresh_token_ref ?? null,\n  token_expires_at:body.token_expires_at ?? null,\n  metadata:body.metadata ?? {}\n}}];"
      },
      "id": "normalize",
      "name": "Normalize Account",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.shopnoltd.dpdns.org/api/v1/omnichannel/connections",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + $env.SHOPNOLTD_INTERNAL_AUTOMATION_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {}
      },
      "id": "register",
      "name": "Register Connection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        80,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond",
      "name": "Respond 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        360,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "account-secret-check",
              "leftValue": "={{!!$env.SHOPNOLTD_N8N_WEBHOOK_SECRET && $json.headers[\"x-shopnoltd-webhook-secret\"] === $env.SHOPNOLTD_N8N_WEBHOOK_SECRET}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "account-auth",
      "name": "Authenticate Webhook",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -300,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ {error:'unauthorized'} }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "account-reject",
      "name": "Reject Unauthenticated Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        -40,
        300
      ]
    }
  ],
  "connections": {
    "Webhook (Account)": {
      "main": [
        [
          {
