# Shopnoltd PostgreSQL backup runtime configuration.
# Keep the real file outside Git; only this example is committed.

POSTGRES_NAMESPACE=shopno-data
POSTGRES_DEPLOYMENT=postgres
BACKUP_BRANCH=database-backups
BACKUP_RETENTION_DAYS=14
BACKUP_WORKDIR=/tmp/shopnoltd-postgres-backup

# Never commit the real encryption key. For GitHub Actions use:
# Settings -> Secrets and variables -> Actions -> BACKUP_ENCRYPTION_KEY
BACKUP_ENCRYPTION_KEY=
